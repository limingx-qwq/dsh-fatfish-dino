{
  "name": "dsh-fatfish-dino",
  "version": "2.0.0",
  "description": "DeepSeek Harness plugin: a floating-ball Fatfish 'choose the right door' runner with a persistent high score, plus a global UI appearance editor (image/video background, glass, gradients) that fills the whole window, exposed as an '外观' section in the settings sidebar via ctx.slots.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "client",
    "assets",
    "demo",
    "tools",
    "README.md"
  ],
  "scripts": {
    "build:client": "python tools/build-client.py"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "door-dash",
    "runner",
    "fatfish",
    "whale-girl",
    "appearance",
    "theme",
    "wallpaper"
  ],
  "license": "MIT"
}
